# M0 环境变量示例：复制为 .env 后按需修改。生产环境一律走凭据库，不落明文。
SHOPPIVOT_ENV=dev
SHOPPIVOT_DATABASE_URL=sqlite:///./storage/shoppivot.db
# PostgreSQL 示例：postgresql+psycopg2://shoppivot:shoppivot@localhost:5432/shoppivot
SHOPPIVOT_STORAGE_DIR=./storage
SHOPPIVOT_JWT_SECRET=dev-only-change-me
SHOPPIVOT_JWT_TTL_MINUTES=480
# 平台数据来源：demo（确定性 fixture，M0 默认）| pdd（需店铺授权与凭据）
SHOPPIVOT_PLATFORM_SOURCE=demo
SHOPPIVOT_PLATFORM=demo
SHOPPIVOT_SHOP_ID=SHOP-0001
# 平台写入上限：M0=L0 / M1=L1 / M2=L2（L2 仅允许经 /write-plans 审批链路执行）
SHOPPIVOT_PLATFORM_GATE_MAX=L2
# 仅用于 F-04 演示：允许创建一条 L2 演示待办（不签发 WriteToken、不执行写入）
SHOPPIVOT_ALLOW_L2_SIMULATION=true
SHOPPIVOT_DAILY_REPORT_CRON=0 8 * * *
SHOPPIVOT_REDIS_URL=redis://localhost:6379/0
SHOPPIVOT_TIMEZONE=Asia/Shanghai
