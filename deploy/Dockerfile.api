FROM python:3.12-slim

ENV PYTHONPATH=/app/src:/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY src ./src
COPY modules ./modules
COPY migrations ./migrations
COPY scripts ./scripts

RUN pip install --no-cache-dir \
    fastapi==0.115.0 uvicorn[standard]==0.30.6 pydantic==2.9.2 pydantic-settings==2.13.1 \
    sqlalchemy==2.0.35 alembic==1.13.0 celery==5.6.2 redis==6.4.0 httpx==0.27.2 \
    openpyxl==3.1.5 pyjwt==2.11.0 pyyaml==6.0.3 packaging==26.0 \
    prometheus-client psycopg2-binary==2.9.12

EXPOSE 8000
CMD ["uvicorn", "bootstrap.api:app", "--host", "0.0.0.0", "--port", "8000"]
